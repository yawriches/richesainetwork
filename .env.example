# Configure these in Vercel → Project → Settings → Environment Variables (or a local .env.local that is never committed).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
KORA_SECRET_KEY=
# Keep false until live payments have received separate approval and validation.
PAYMENTS_LIVE_ENABLED=false
# Your public site address, e.g. https://richesainetwork.vercel.app (no trailing slash).
APP_ORIGIN=
# Bunny Stream community video credentials. Keep all four server-side.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_READ_ONLY_API_KEY=
